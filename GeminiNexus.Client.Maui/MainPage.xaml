<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GeminiNexus.Client.Maui.MainPage" BackgroundColor="#131314">
    <VerticalStackLayout x:Name="ServerForm" Padding="30" Spacing="20" VerticalOptions="Center" FlowDirection="RightToLeft">
        <Label Text="Gemini Nexus" FontSize="32" TextColor="#A8C7FA" />
        <Label Text="כתובת השרת שלך" TextColor="#E3E3E3" />
        <Entry x:Name="ServerAddress" Placeholder="https://chat.example.com/" Keyboard="Url" TextColor="#E3E3E3" FlowDirection="LeftToRight" />
        <Label x:Name="ValidationError" TextColor="#FFAEB7" />
        <Button Text="פתיחת סביבת העבודה" Clicked="Connect" BackgroundColor="#A8C7FA" TextColor="#131314" />
    </VerticalStackLayout>
</ContentPage>
