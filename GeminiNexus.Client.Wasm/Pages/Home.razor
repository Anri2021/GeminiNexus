@page "/"
@inject HttpClient Http
@using System.Diagnostics
@using System.Text
@using System.Text.Json
@using GeminiNexus.Shared.Contracts
@using GeminiNexus.UI.Components
@using Microsoft.AspNetCore.Components.Web.Virtualization

<DexBar Users="users"
        AvailableModels="models"
        ActiveUserId="@activeUserId"
        ActiveModel="@activeModel"
        ActiveSessionId="@activeSessionId"
        TokensPerSec="@tokensPerSec"
        LastPromptTokens="@lastPromptTokens"
        LastCandidateTokens="@lastCandidateTokens"
        TotalSessionTokens="@totalSessionTokens"
        OnUserSelected="HandleUserSelected"
        OnModelSelected="HandleModelSelected" />

<VirtualChatView @ref="virtualChatRef"
                 LoadMessagesAsync="LoadMessagesAsync"
                 IsStreaming="@isStreaming"
                 StreamingContent="@streamingContent"
                 OnInspectRequested="OpenInspector" />

<InspectorDrawer IsOpen="@isInspectorOpen"
                 TargetMessage="@inspectedMessage"
                 OnClose="() => isInspectorOpen = false" />

<ChatInput IsStreaming="@isStreaming"
           OnSendMessage="SendMessageAsync"
           OnAbort="AbortStreaming" />

@code {
    private bool isInspectorOpen = false;
    private ChatMessage? inspectedMessage= null;

    private VirtualChatView? virtualChatRef;

    private readonly List<UserProfile> users =
    [
        new("usr_1", "Henri (ראשי)", ""),
        new("usr_2", "פרופיל פיתוח", "")
    ];

    private readonly List<ModelDefinition> models =
    [
        new("gemini-2.5-flash", "Gemini 2.5 Flash", "1M Context", 1000000),
        new("gemini-2.5-pro", "Gemini 2.5 Pro", "2M Context", 2000000),
        new("gemini-1.5-flash", "Gemini 1.5 Flash", "1M Context", 1000000),
        new("gemini-1.5-pro", "Gemini 1.5 Pro", "2M Context", 2000000)
    ];

    private string activeUserId = "usr_1";
    private string activeModel = "gemini-2.5-flash";
    private string activeSessionId = Guid.NewGuid().ToString("N")[..8];

    private double tokensPerSec = 0;
    private int lastPromptTokens = 0;
    private int lastCandidateTokens = 0;
    private int totalSessionTokens = 0;

    private bool isStreaming = false;
    private string streamingContent = string.Empty;
    private CancellationTokenSource? cts;

    private readonly List<ChatMessage> messages = [];

    private ValueTask<ItemsProviderResult<ChatMessage>> LoadMessagesAsync(ItemsProviderRequest req)
    {
        var count = Math.Min(req.Count, Math.Max(0, messages.Count - req.StartIndex));
        var slice = messages.Skip(req.StartIndex).Take(count).ToList();
        return ValueTask.FromResult(new ItemsProviderResult<ChatMessage>(slice, messages.Count));
    }

    private void HandleUserSelected(string userId)
    {
        activeUserId = userId;
        ResetSession();
    }

    private void HandleModelSelected(string modelId)
    {
        activeModel = modelId;
    }

    private void ResetSession()
    {
        activeSessionId = Guid.NewGuid().ToString("N")[..8];
        messages.Clear();
        lastPromptTokens = 0;
        lastCandidateTokens = 0;
        totalSessionTokens = 0;
        tokensPerSec = 0;
        StateHasChanged();
    }

    private async Task SendMessageAsync(string prompt)
    {
        if (string.IsNullOrWhiteSpace(prompt) || isStreaming) return;

        // ספירת טוקנים רשמית מהשרת עבור הפרומפט
        try
        {
            var countReq = new CountTokensRequest(activeModel, prompt);
            var countRes = await Http.PostAsJsonAsync("http://localhost:5000/api/chat/count-tokens", countReq, AppJsonSerializerContext.Default.CountTokensRequest);
            if (countRes.IsSuccessStatusCode)
            {
                var resObj = await countRes.Content.ReadFromJsonAsync(AppJsonSerializerContext.Default.CountTokensResponse);
                lastPromptTokens = resObj.TotalTokens;
            }
        }
        catch
        {
            lastPromptTokens = prompt.Length / 4;
        }

        messages.Add(new ChatMessage(
            messages.Count + 1,
            activeSessionId,
            "user",
            prompt,
            lastPromptTokens,
            0,
            0,
            0,
            0,
            DateTime.UtcNow
        ));

        isStreaming = true;
        streamingContent = string.Empty;
        tokensPerSec = 0;
        lastCandidateTokens = 0;
        cts = new CancellationTokenSource();
        StateHasChanged();

        var sw = Stopwatch.StartNew();

        var rawJsonBuilder = new StringBuilder();
        string finishReason = "STOP";
        string modelVersion = activeModel;
        string safetySummary = "Normal";
        string groundingJson = "[]";
        int cachedTokens = 0;

        var citationsList = new List<CitationInfo>();

        int streamedChunks = 0;

        try
        {
            var req = new StreamChatRequest(activeSessionId, activeUserId, prompt, activeModel);
            var jsonPayload = JsonSerializer.Serialize(req, AppJsonSerializerContext.Default.StreamChatRequest);
            var content = new StringContent(jsonPayload, Encoding.UTF8, "application/json");

            using var request = new HttpRequestMessage(HttpMethod.Post, "http://localhost:5000/api/chat/stream")
                {
                    Content = content
                };

            using var response = await Http.SendAsync(request, HttpCompletionOption.ResponseHeadersRead, cts.Token);
            response.EnsureSuccessStatusCode();

            await using var stream = await response.Content.ReadAsStreamAsync(cts.Token);
            using var reader = new StreamReader(stream);

            while (!cts.Token.IsCancellationRequested && await reader.ReadLineAsync(cts.Token) is { } line)
            {
                if (string.IsNullOrWhiteSpace(line) || !line.StartsWith("data:")) continue;

                var data = line["data:".Length..].Trim();
                if (data == "[DONE]") break;

                try
                {
                    rawJsonBuilder.AppendLine(data);

                    using var doc = JsonDocument.Parse(data);
                    var root = doc.RootElement;

                    // 1. גרסת מודל משרתי Google
                    if (root.TryGetProperty("modelVersion", out var mVer))
                        modelVersion = mVer.GetString() ?? modelVersion;

                    // 2. חילוץ טקסט שוטף, סיבת סיום, בטיחות וציטוטים
                    if (root.TryGetProperty("candidates", out var cands) && cands.GetArrayLength() > 0)
                    {
                        var firstCand = cands[0];

                        // הזרמת תוכן הטקסט למסך
                        if (firstCand.TryGetProperty("content", out var cObj) &&
                            cObj.TryGetProperty("parts", out var parts) &&
                            parts.GetArrayLength() > 0 &&
                            parts[0].TryGetProperty("text", out var textElem))
                        {
                            var chunk = textElem.GetString();
                            if (!string.IsNullOrEmpty(chunk))
                            {
                                streamingContent += chunk;
                                streamedChunks++;

                                var elapsedSec = sw.Elapsed.TotalSeconds;
                                if (elapsedSec > 0)
                                {
                                    tokensPerSec = streamedChunks / elapsedSec;
                                }
                                StateHasChanged();
                            }
                        }

                        if (firstCand.TryGetProperty("finishReason", out var fReason))
                            finishReason = fReason.GetString() ?? finishReason;

                        if (firstCand.TryGetProperty("safetyRatings", out var sRatings))
                            safetySummary = sRatings.GetRawText();

                        if (firstCand.TryGetProperty("groundingMetadata", out var gMeta))
                            groundingJson = gMeta.GetRawText();

                        // שליפת מקורות ורישיונות קוד
                        if (firstCand.TryGetProperty("citationMetadata", out var cMeta) &&
                            cMeta.TryGetProperty("citationSources", out var cSources) &&
                            cSources.ValueKind == JsonValueKind.Array)
                        {
                            citationsList.Clear();
                            foreach (var src in cSources.EnumerateArray())
                            {
                                var uri = src.TryGetProperty("uri", out var u) ? u.GetString() : null;
                                var lic = src.TryGetProperty("license", out var l) ? l.GetString() : null;
                                var start = src.TryGetProperty("startIndex", out var s) ? s.GetInt32() : 0;
                                var end = src.TryGetProperty("endIndex", out var e) ? e.GetInt32() : 0;
                                citationsList.Add(new CitationInfo(uri, lic, start, end));
                            }
                        }
                    }

                    // 3. חילוץ טוקנים מדויקים מ-usageMetadata של גוגל
                    if (root.TryGetProperty("usageMetadata", out var usage))
                    {
                        if (usage.TryGetProperty("promptTokenCount", out var pCount))
                            lastPromptTokens = pCount.GetInt32();

                        if (usage.TryGetProperty("candidatesTokenCount", out var cCount))
                            lastCandidateTokens = cCount.GetInt32();

                        if (usage.TryGetProperty("cachedContentTokenCount", out var cacheCount))
                            cachedTokens = cacheCount.GetInt32();

                        if (usage.TryGetProperty("totalTokenCount", out var tCount))
                            totalSessionTokens += tCount.GetInt32();
                    }
                }
                catch (JsonException)
                {
                    // התעלמות משברי נתונים בלתי-שלמים ב-Stream
                }
            }
        }
        catch (OperationCanceledException)
        {
            // עצירה יזומה
        }
        catch (Exception ex)
        {
            streamingContent += $"\n[שגיאת חיבור: {ex.Message}]";
        }
        finally
        {
            sw.Stop();

            if (lastCandidateTokens == 0)
                lastCandidateTokens = streamedChunks;

            if (sw.Elapsed.TotalSeconds > 0 && lastCandidateTokens > 0)
                tokensPerSec = lastCandidateTokens / sw.Elapsed.TotalSeconds;

            var telemetry = new MessageTelemetry(
            finishReason,
            modelVersion,
            cachedTokens,
            safetySummary,
            groundingJson,
            rawJsonBuilder.ToString(),
            citationsList
            );

            messages.Add(new ChatMessage(
            messages.Count + 1,
            activeSessionId,
            "model",
            streamingContent,
            lastPromptTokens,
            lastCandidateTokens,
            cachedTokens,
            tokensPerSec,
            sw.ElapsedMilliseconds,
            DateTime.UtcNow,
            telemetry
            ));

            isStreaming = false;
            streamingContent = string.Empty;
            StateHasChanged();
        }
    }

    private void AbortStreaming() => cts?.Cancel();

    private void OpenInspector(ChatMessage msg)
    {
        inspectedMessage = msg;
        isInspectorOpen = true;
    }
}