<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>7e116605-77b2-4c6d-ac33-7dc97e3480e9</UserSecretsId>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <DefineConstants>$(DefineConstants);NEXUS_NATIVE_AOT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.86" Condition="'$(PublishAot)' != 'true'" />
    <PackageReference Include="Dapper.AOT" Version="1.1.0" Condition="'$(PublishAot)' != 'true'" />
    <PackageReference Include="FastEndpoints" Version="8.3.0" />
    <PackageReference Include="FastEndpoints.Generator" Version="8.3.0" PrivateAssets="all" />
    <PackageReference Include="Npgsql" Version="10.0.0" />
    <PackageReference Include="Polly" Version="8.8.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeminiNexus.Shared\GeminiNexus.Shared.csproj" />
    <None Include="..\native\libnexus_native.so" Link="libnexus_native.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('..\native\libnexus_native.so')" />
  </ItemGroup>

</Project>
