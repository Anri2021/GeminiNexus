{
  "Urls": "https://localhost:5000",
  "AllowedHosts": "*",
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "System.Net.Http.HttpClient": "Warning" } },
  "Database": { "Provider": "Sqlite", "ConnectionString": "Data Source=data/nexus.db;Default Timeout=15" },
  "Gemini": { "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/", "LiveUrl": "wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent", "DefaultModel": "gemini-3.8-flash" },
  "Auth": { "AdminName": "admin", "KeyPath": "data/keys", "AllowInsecureLocal": "false" },
  "Processing": { "Workers": 4, "PerUserConcurrency": 2, "MaxQueuedPerUser": 32, "RunTimeoutSeconds": 600 },
  "Limits": { "MaxPromptChars": 100000, "MaxResponseChars": 1000000, "MaxAttachmentBytes": 104857600, "MaxPdfBytes": 52428800, "MaxAttachments": 10, "MaxTraceBytes": 16777216, "MaxHistoryBytes": 33554432, "MaxEventBytes": 4194304, "TraceRetentionDays": 14 },
  "Plugins": { "Directory": "data/plugins", "WasmtimePath": "wasmtime", "TimeoutSeconds": 10 },
  "Proxy": { "KnownProxies": [] }
}
