<div class="gemini-floating-input-zone">
    <div class="gemini-input-pill">
        <textarea class="gemini-textarea"
                  @bind="InputText"
                  @bind:event="oninput"
                  @onkeydown="HandleKeyDown"
                  placeholder="שאל את Gemini..."
                  rows="1"></textarea>

        @if (IsStreaming)
        {
            <button class="gemini-action-btn btn-abort-gemini" @onclick="OnAbortClicked" title="עצור מענה">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                    <rect x="4" y="4" width="16" height="16" rx="2" />
                </svg>
            </button>
        }
        else
        {
            <button class="gemini-action-btn btn-send-gemini"
                    @onclick="OnSendClicked"
                    disabled="@string.IsNullOrWhiteSpace(InputText)"
                    title="שלח">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M2.01 21L23 12L2.01 3L2 10L17 12L2 14L2.01 21Z" />
                </svg>
            </button>
        }
    </div>
    <div class="gemini-disclaimer">Gemini Nexus עשוי להציג מידע לא מדויק, יש לוודא מידע רגיש.</div>
</div>

@code {
    [Parameter] public bool IsStreaming { get; set; }
    [Parameter] public EventCallback<string> OnSendMessage { get; set; }
    [Parameter] public EventCallback OnAbort { get; set; }

    private string InputText { get; set; } = string.Empty;

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await OnSendClicked();
        }
    }

    private async Task OnSendClicked()
    {
        if (string.IsNullOrWhiteSpace(InputText) || IsStreaming) return;
        var text = InputText.Trim();
        InputText = string.Empty;
        await OnSendMessage.InvokeAsync(text);
    }

    private async Task OnAbortClicked() => await OnAbort.InvokeAsync();
}