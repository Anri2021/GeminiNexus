@using GeminiNexus.Shared.Contracts

@if (IsOpen && TargetMessage.HasValue)
{
    var msg = TargetMessage.Value;
    var t = msg.Telemetry ?? new MessageTelemetry("STOP", "gemini-2.5", 0, "None", "[]", "{}");

    <div class="inspector-backdrop" @onclick="CloseDrawer"></div>
    <aside class="gemini-inspector">
        <div class="inspector-header">
            <h3>טלמטריה ונתוני API</h3>
            <button class="btn-close-drawer" @onclick="CloseDrawer">✕</button>
        </div>

        <div class="inspector-tabs">
            <button class="tab-btn @(activeTab == 0 ? "active" : "")" @onclick="() => activeTab = 0">טוקנים וביצועים</button>
            <button class="tab-btn @(activeTab == 1 ? "active" : "")" @onclick="() => activeTab = 1">בטיחות ומודל</button>
            <button class="tab-btn @(activeTab == 2 ? "active" : "")" @onclick="() => activeTab = 2">ביסוס (Grounding)</button>
            <button class="tab-btn @(activeTab == 3 ? "active" : "")" @onclick="() => activeTab = 3">Raw JSON</button>
            <button class="tab-btn @(activeTab == 4 ? "active" : "")" @onclick="() => activeTab = 4">מקורות וקוד</button>
        </div>

        <div class="inspector-body">
            @if (activeTab == 0)
            {
                <div class="telemetry-grid">
                    <div class="stat-card">
                        <label>קצב פליטה</label>
                        <value>@msg.TokensPerSecond.ToString("F1") T/s</value>
                    </div>
                    <div class="stat-card">
                        <label>זמן תגובה</label>
                        <value>@(msg.ElapsedMilliseconds)ms</value>
                    </div>
                    <div class="stat-card">
                        <label>טוקני קלט (Prompt)</label>
                        <value>@msg.PromptTokens</value>
                    </div>
                    <div class="stat-card">
                        <label>טוקני פלט (Candidates)</label>
                        <value>@msg.CandidateTokens</value>
                    </div>
                    <div class="stat-card">
                        <label>זיכרון מטמון (Cached)</label>
                        <value>@msg.CachedTokens</value>
                    </div>
                    <div class="stat-card">
                        <label>סיבת סיום (Finish Reason)</label>
                        <value class="highlight">@t.FinishReason</value>
                    </div>
                </div>
            }
            else if (activeTab == 1)
            {
                <div class="info-section">
                    <p><strong>גרסת מודל משרתי Google:</strong> <code>@t.ModelVersion</code></p>
                    <p><strong>סטטוס בטיחות (Safety Ratings):</strong></p>
                    <div class="code-box">@t.SafetySummary</div>
                </div>
            }
            else if (activeTab == 2)
            {
                <div class="info-section">
                    <p><strong>מקורות מידע וחיפוש (Grounding Metadata):</strong></p>
                    <div class="code-box">@t.GroundingSourcesJson</div>
                </div>
            }
            else if (activeTab == 3)
            {
                <div class="raw-json-container">
                    <button class="btn-copy-raw" @onclick="CopyJsonToClipboard">העתק JSON מלא</button>
                    <pre class="raw-code">@t.RawJson</pre>
                </div>
            }
            else if (activeTab == 4)
            {
                <div class="info-section">
                    <p><strong>ציטוטים ורישיונות קוד (Citation Metadata):</strong></p>
                    @if (t.Citations != null && t.Citations.Count > 0)
                    {
                        <div style="display:flex; flex-direction:column; gap:8px;">
                            @foreach (var c in t.Citations)
                            {
                                <div class="stat-card">
                                    <label>קישור: <a href="@c.Uri" target="_blank" style="color:var(--gemini-accent-blue);">@c.Uri</a></label>
                                    <value style="font-size:0.85rem;">רישיון: @(c.License ?? "לא צוין") | טווח: @c.StartIndex-@c.EndIndex</value>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p style="color:var(--gemini-text-secondary); font-size:0.85rem;">לא זוהו ציטוטים מוגנים או קוד פתוח בתשובה זו.</p>
                    }
                </div>
            }
        </div>
    </aside>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public ChatMessage? TargetMessage { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private int activeTab = 0;

    private async Task CloseDrawer() => await OnClose.InvokeAsync();

    private void CopyJsonToClipboard()
    {
        // העתקה ניתנת להפעלה ישירה או דרך JSInterop
    }
}