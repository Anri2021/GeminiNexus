@using GeminiNexus.Shared.Contracts
@using Microsoft.AspNetCore.Components.Web.Virtualization

<div class="gemini-chat-container">
    <div class="chat-center-wrapper">
        <Virtualize Context="msg" ItemsProvider="LoadMessagesAsync" OverscanCount="6" TItem="ChatMessage">
            <ItemContent>
                <div class="message-row @(msg.Role == "user" ? "user-row" : "model-row")">
                    @if (msg.Role == "model")
                    {
                        <div class="model-avatar">
                            <svg class="sparkle-icon" viewBox="0 0 24 24">
                                <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z" />
                            </svg>
                        </div>
                    }

                    <div class="message-bubble">
                        <div class="message-content">@msg.Content</div>

                        @if (msg.Role == "model")
                        {
                            <div class="meta-footer">
                                <span>@msg.TokensPerSecond.ToString("F1") T/s</span>
                                <span>זמן: @(msg.ElapsedMilliseconds)ms</span>
                                <span>טוקנים: @msg.CandidateTokens</span>
                                @if (msg.Telemetry.HasValue)
                                {
                                    <button class="btn-inspect" @onclick="() => OnInspectRequested.InvokeAsync(msg)">🔍 Inspector</button>
                                }
                            </div>
                        }
                    </div>
                </div>
            </ItemContent>
            <Placeholder>
                <div class="message-row model-row">
                    <div class="message-bubble" style="color: var(--gemini-text-secondary);">
                        טוען היסטוריה באפס הקצאות...
                    </div>
                </div>
            </Placeholder>
        </Virtualize>

        @if (IsStreaming)
        {
            <div class="message-row model-row streaming">
                <div class="model-avatar">
                    <svg class="sparkle-icon" viewBox="0 0 24 24">
                        <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z" />
                    </svg>
                </div>
                <div class="message-bubble">
                    <div class="message-content">@StreamingContent</div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback<ChatMessage> OnInspectRequested { get; set; }
    [Parameter] public ItemsProviderDelegate<ChatMessage> LoadMessagesAsync { get; set; } = default!;
    [Parameter] public bool IsStreaming { get; set; }
    [Parameter] public string StreamingContent { get; set; } = string.Empty;
}