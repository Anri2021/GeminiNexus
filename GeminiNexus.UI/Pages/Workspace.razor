    private async Task Explore()=>await Guard(async()=>{busy=true;try{if(labMethod!="GET"&&!await JS.InvokeAsync<bool>("confirm","לשלוח בקשה שעשויה לשנות משאבים או לצרוך מכסה?"))return;var response=await Api.Send(HttpMethod.Post,"explorer",new PlaygroundRequest(labMethod,labPath,labBody),NexusJson.Default.PlaygroundRequest,NexusJson.Default.PlaygroundResponse);labResult=$"HTTP {response.Status}\n{Pretty(response.Body)}";}finally{busy=false;}});
    private async Task Inspect(string run){inspectedRun=run;panel="debug";await RefreshDebug();}
    private async Task DebugRunChanged(ChangeEventArgs e){inspectedRun=e.Value?.ToString()??"";await RefreshDebug();}
    private async Task RefreshDebug(){debugEvents=[];debugMore=true;if(inspectedRun.Length>0)await LoadDebug();}
    private async Task LoadDebug()=>await Guard(async()=>{if(inspectedRun.Length==0)return;var after=debugEvents.LastOrDefault()?.Sequence??0;var page=await Api.Get($"runs/{inspectedRun}/events?format=json&after={after}",NexusJson.Default.RunEventPage);debugEvents.AddRange(page.Items);debugMore=page.HasMore;long bytes=debugEvents.Sum(e=>(long)e.Json.Length*2);while(debugEvents.Count>1&&(debugEvents.Count>200||bytes>settings.MaxBufferedBytes)){bytes-=debugEvents[0].Json.Length*2L;debugEvents.RemoveAt(0);}});
    private string Usage(string name){foreach(var ev in debugEvents.AsEnumerable().Reverse().Where(e=>e.Kind=="provider")){using var d=JsonDocument.Parse(ev.Json);if(d.RootElement.TryGetProperty("usageMetadata",out var u)&&u.TryGetProperty(name,out var n))return n.ToString();}return "לא דווח";}
    private static string Pretty(string json){try{using var doc=JsonDocument.Parse(json);using var memory=new MemoryStream();using(var writer=new Utf8JsonWriter(memory,new(){Indented=true})){doc.RootElement.WriteTo(writer);}return System.Text.Encoding.UTF8.GetString(memory.ToArray());}catch(JsonException){return json;}}
    public async ValueTask DisposeAsync(){lifetime.Cancel();selection?.Cancel();searchCancel?.Cancel();if(polling is not null)await polling;if(streamTask is not null)await streamTask;if(module is not null){try{await module.InvokeVoidAsync("dispose");await module.DisposeAsync();}catch(JSDisconnectedException){}}reference?.Dispose();selection?.Dispose();searchCancel?.Dispose();lifetime.Dispose();}
