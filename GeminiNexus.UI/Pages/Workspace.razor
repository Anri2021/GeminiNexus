    private void SetFields(){pageSize=settings.MessagePageSize;bufferTurns=settings.MaxBufferedTurns;bufferMb=settings.MaxBufferedBytes/1048576;overscan=settings.OverscanCount;renderMs=settings.RenderIntervalMs;contextTurns=settings.Generation.ContextMaxTurns;tokenBudget=settings.Generation.ContextTokenBudget;outputTokens=settings.Generation.MaxOutputTokens;temperature=settings.Generation.Temperature;systemInstruction=settings.Generation.SystemInstruction;advancedJson=settings.Generation.AdvancedJson;}
