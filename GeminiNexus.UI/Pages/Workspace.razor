    private async Task SaveSettings()=>await Guard(async()=>{var updated=settings with{MessagePageSize=pageSize,MaxBufferedTurns=bufferTurns,MaxBufferedBytes=bufferMb*1048576,OverscanCount=overscan,RenderIntervalMs=renderMs,Generation=Generation()};await Api.Save(HttpMethod.Put,"settings",updated,NexusJson.Default.WorkspaceSettings);settings=updated;Trim(false);await RefreshMessages();panel=null;});
