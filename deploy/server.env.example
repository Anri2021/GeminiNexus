# Supply newly rotated values through files readable only by the service identity.
Gemini__ApiKeyFile=/etc/gemininexus/gemini-key
Auth__AdminPasswordFile=/etc/gemininexus/admin-password
Auth__AdminName=admin
AllowedHosts=chat.example.com
Database__Provider=Postgres
Database__ConnectionString=Host=127.0.0.1;Port=5432;Database=nexus;Username=nexus;Password=replace-through-a-protected-environment-file;Pooling=true
Plugins__Directory=/var/lib/gemininexus/plugins
Plugins__WasmtimePath=/usr/local/bin/wasmtime
Proxy__KnownProxies__0=127.0.0.1
